  "envs": {
    "core": {
      "label": "Hub & data tools",
      "packages": [
        "huggingface_hub[hf_xet]>=1.0",
        "datasets>=4.0",
        "numpy",
        "zstandard"
      ]
    },
    "gguf": {
      "label": "GGUF converter",
      "requirements_from_source": "requirements/requirements-convert_hf_to_gguf.txt",
      "packages": [
        "jinja2",
        "tiktoken"
      ],
      "local_packages": [
        "gguf-py"
      ]
    },
    "mlx": {
      "label": "MLX (Apple Silicon)",
      "packages": [
        "mlx-lm==0.32.2",
        "datasets>=4.0"
      ],
      "platforms": [
        "macos-aarch64"
      ]
    },
    "onnx": {
      "label": "ONNX Runtime GenAI",
      "packages": [
        "onnxruntime-genai==0.18.0",
        "onnx>=1.17",
        "onnx-ir",
        "torch",
        "transformers>=5.0",
        "sentencepiece",
        "protobuf",
        "jinja2",
        "psutil"
      ],
      "cuda_packages": [
        "onnxruntime-genai-cuda==0.18.0",
        "onnx>=1.17",
        "onnx-ir",
        "torch",
        "transformers>=5.0",
        "sentencepiece",
